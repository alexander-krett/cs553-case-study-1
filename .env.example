# Copy to .env (chmod 600). Never commit .env.

# --- Identity ---
COMPOSE_PROJECT_NAME=resumelens_cs3
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=v1

# --- Host ports (the shared VM only allows 2100-2110) ---
# 0.0.0.0 makes the ports reachable on the VM's network; 127.0.0.1 keeps them private.
BIND_ADDRESS=0.0.0.0
PUBLIC_GATEWAY_PORT=2100
API_UI_PORT=2101
LOCAL_UI_PORT=2102
PROMETHEUS_PORT=2103
GRAFANA_PORT=2104
API_METRICS_PORT=2105
API_NODE_PORT=2106
LOCAL_METRICS_PORT=2107
LOCAL_NODE_PORT=2108
NGROK_API_PORT=2109

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Set automatically by scripts/up.sh when ngrok is enabled.
PUBLIC_BASE_URL=http://localhost:2100

# --- ngrok (leave blank to skip publishing) ---
NGROK_AUTHTOKEN=
# Optional free static domain from the ngrok dashboard, e.g. example.ngrok-free.app
NGROK_DOMAIN=

# --- Models ---
# The API product's Hugging Face token is entered in its web UI, not here.
REMOTE_PRIMARY_MODEL=openai/gpt-oss-20b
REMOTE_BACKUP_MODEL=zai-org/GLM-5.3-Flash
# Local models are Q4 GGUF files: Hugging Face repo + filename pattern.
LOCAL_PRIMARY_MODEL=unsloth/Qwen3-0.6B-GGUF
LOCAL_PRIMARY_FILE=*Q4_K_M.gguf
LOCAL_BACKUP_MODEL=LiquidAI/LFM2.5-1.2B-Instruct-GGUF
LOCAL_BACKUP_FILE=*QAD-Q4_0.gguf
LOCAL_CONTEXT_SIZE=4096
LOCAL_MEM_LIMIT=3g
LOCAL_CPUS=2
INFERENCE_TIMEOUT=300
